+fn counterHostPoll(effects: *CounterApp.Effects) void {
+    _ = effects;
+    counter_host_poll_calls += 1;
+}
+
+const CounterHostWakeThread = struct {
+    fn run(effects: *CounterApp.Effects) void {
+        effects.requestWake() catch unreachable;
+    }
+};
+
+test "ui app host worker wake reaches host poll and revokes at teardown" {
+    counter_host_poll_calls = 0;
+
+    const harness = try core.TestHarness().create(std.testing.allocator, .{ .size = geometry.SizeF.init(400, 300) });
+    defer harness.destroy(std.testing.allocator);
+    harness.null_platform.gpu_surfaces = true;
+
+    var options = counterOptions();
+    options.host_poll = counterHostPoll;
+    options.host_deinit = counterHostDeinit;
+    const app_state = try std.testing.allocator.create(CounterApp);
+    defer std.testing.allocator.destroy(app_state);
+    app_state.* = CounterApp.init(std.heap.page_allocator, .{}, options);
+    var app_state_needs_deinit = true;
+    defer if (app_state_needs_deinit) app_state.deinit();
+    const app = app_state.app();
+    try harness.start(app);
+    try harness.runtime.dispatchPlatformEvent(app, .{ .gpu_surface_frame = .{
+        .label = canvas_label,
+        .size = geometry.SizeF.init(400, 300),
+        .scale_factor = 1,
+        .frame_index = 1,
+        .timestamp_ns = 1_000_000,
+        .nonblank = true,
+    } });
+    try std.testing.expectEqual(@as(u32, 1), counter_host_poll_calls);
+
+    var worker = try std.Thread.spawn(.{}, CounterHostWakeThread.run, .{&app_state.effects});
+    worker.join();
+    try std.testing.expectEqual(@as(usize, 1), harness.null_platform.pendingWakeCount());
+    try harness.runtime.dispatchPlatformEvent(app, harness.null_platform.takeWake().?);
+    try std.testing.expectEqual(@as(u32, 2), counter_host_poll_calls);
+
+    try app.stop(&harness.runtime);
+    try std.testing.expectError(error.HostWakeUnavailable, app_state.effects.requestWake());
+    app_state.deinit();
+    app_state_needs_deinit = false;
+}
+
+test "ui app host deinit runs exactly once across stop and owner teardown" {
+    counter_host_deinit_calls = 0;
+
+    const harness = try core.TestHarness().create(std.testing.allocator, .{ .size = geometry.SizeF.init(400, 300) });
+    defer harness.destroy(std.testing.allocator);
+    harness.null_platform.gpu_surfaces = true;
+
+    var options = counterOptions();
+    options.host_deinit = counterHostDeinit;
+    const app_state = try std.testing.allocator.create(CounterApp);
+    defer std.testing.allocator.destroy(app_state);
+    app_state.* = CounterApp.init(std.heap.page_allocator, .{}, options);
+    var app_state_needs_deinit = true;
+    defer if (app_state_needs_deinit) app_state.deinit();
+    const app = app_state.app();
+    try harness.start(app);
+
+    // The runtime stop hook owns the first shutdown transition.
+    try app.stop(&harness.runtime);
+    try std.testing.expectEqual(@as(u32, 1), counter_host_deinit_calls);
+
+    // A repeated stop and the later owner teardown must both remain
+    // idempotent: host workers cannot be joined or freed twice.
+    try app.stop(&harness.runtime);
+    try std.testing.expectEqual(@as(u32, 1), counter_host_deinit_calls);
+    app_state.deinit();
+    app_state_needs_deinit = false;
+    try std.testing.expectEqual(@as(u32, 1), counter_host_deinit_calls);
+}
+
+test "ui app host deinit runs once on owner-only teardown" {
+    counter_host_deinit_calls = 0;
+
+    var options = counterOptions();
+    options.host_deinit = counterHostDeinit;
+    var app_state = CounterApp.init(std.heap.page_allocator, .{}, options);
+    app_state.deinit();
+
+    try std.testing.expectEqual(@as(u32, 1), counter_host_deinit_calls);
+}
