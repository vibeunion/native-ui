--- /dev/null
+++ b/packages/core/test/stage_external_core.test.ts
@@ -0,0 +1,85 @@
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+
+test("external core staging removes Uint8Array aliases and imports after Bytes folding", () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "native-core-stage-"));
+  try {
+    const src = path.join(root, "src");
+    const sdk = path.join(root, "sdk");
+    const out = path.join(root, "out");
+    fs.mkdirSync(src);
+    fs.mkdirSync(sdk);
+    fs.writeFileSync(path.join(src, "core.ts"), `
+import type { Bytes } from "@native-sdk/core";
+import { Cmd, Bytes } from "@native-sdk/core";
+export function decode(bytes: Bytes): number { return new DataView(bytes.buffer).getUint32(0, true); }
+export function update(): Uint8Array { void Cmd; return new Uint8Array(0); }
+`);
+    fs.writeFileSync(path.join(src, "singleton-value.ts"), `
+import { Bytes } from "@native-sdk/core";
+export function value(bytes: Bytes): Uint8Array { return bytes; }
+`);
+    fs.writeFileSync(path.join(src, "singleton-type-specifier.ts"), `
+import { type Bytes } from "@native-sdk/core";
+export function typed(bytes: Bytes): Uint8Array { return bytes; }
+`);
+    fs.writeFileSync(path.join(src, "alias-value.ts"), `
+import { Bytes as Payload } from "@native-sdk/core";
+export function aliased(bytes: Payload): Uint8Array { return bytes; }
+export function shadowed(Payload: number): number { return Payload; }
+`);
+    fs.writeFileSync(path.join(src, "alias-type-specifier.ts"), `
+import { type Bytes as Payload } from "@native-sdk/core";
+export function aliasedType(bytes: Payload): Uint8Array { return bytes; }
+`);
+    fs.writeFileSync(path.join(src, "alias-type-clause.ts"), `
+import type { Bytes as Payload } from "@native-sdk/core";
+export function aliasedClause(bytes: Payload): Uint8Array { return bytes; }
+`);
+    fs.writeFileSync(path.join(sdk, "text.ts"), "export interface TextValue { readonly bytes: Uint8Array; }\n");
+    fs.writeFileSync(path.join(sdk, "events.ts"), "export interface EventValue { readonly bytes: Uint8Array; }\n");
+    const staticCore = path.join(root, "static.ts");
+    const facade = path.join(root, "facade.ts");
+    const profile = path.join(root, "profile.json");
+    fs.writeFileSync(staticCore, "export const Cmd = {};\n");
+    fs.writeFileSync(facade, "export {};\n");
+    fs.writeFileSync(profile, "{}\n");
+
+    const script = path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "scripts", "stage_external_core.mjs");
+    const result = spawnSync(process.execPath, [
+      script,
+      "--src", src,
+      "--sdk", sdk,
+      "--static", staticCore,
+      "--facade", facade,
+      "--profile", profile,
+      "--out", out,
+    ], { encoding: "utf8" });
+    assert.equal(result.status, 0, `${result.stdout}${result.stderr}`);
+
+    const staged = fs.readFileSync(path.join(out, "core.ts"), "utf8");
+    assert.doesNotMatch(staged, /import type \{ Uint8Array \}/);
+    assert.doesNotMatch(staged, /import type \{ Bytes \}/);
+    assert.match(staged, /import \{ Cmd \} from "\.\/sdk\/core\.ts";/);
+    assert.match(staged, /decode\(bytes: Uint8Array\)/);
+    for (const file of ["singleton-value.ts", "singleton-type-specifier.ts"]) {
+      const singleton = fs.readFileSync(path.join(out, file), "utf8");
+      assert.doesNotMatch(singleton, /import .*Uint8Array.* from "\.\/sdk\/core\.ts";/);
+      assert.match(singleton, /bytes: Uint8Array/);
+    }
+    for (const file of ["alias-value.ts", "alias-type-specifier.ts", "alias-type-clause.ts"]) {
+      const aliased = fs.readFileSync(path.join(out, file), "utf8");
+      assert.doesNotMatch(aliased, /import .*Payload.* from "\.\/sdk\/core\.ts";/);
+      assert.match(aliased, /bytes: Uint8Array/);
+    }
+    const aliasValue = fs.readFileSync(path.join(out, "alias-value.ts"), "utf8");
+    assert.match(aliasValue, /shadowed\(Payload: number\): number \{ return Payload; \}/);
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
